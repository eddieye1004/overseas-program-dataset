ified":true,"max_stay_months":4,"education":"any","enrollment_scope":"unknown","language_required":true,"funds_amount":null,"funds_currency":null,"risk_levels":["critical","critical","warning","warning","warning","info"],"last_verified":"2026-11-08","source_count":7,"source_primary":7},{"id":"us-j1-intern","name":"美国 J-1 实习项目","name_en":"Intern (J-1 Exchange Visitor Program)","country":"美国","country_code":"US","region":"north_america","program_type":"paid_internship","visa_code":"J-1","official_url":"https://j1visa.state.gov/programs/intern/","authority":"U.S. Department of State, Bureau of Educational and Cultural Affairs（美国国务院教育与文化事务局）","summary":"美国国务院 J-1 交流访问者项目下的实习类别：在美企业从事与所学专业相关的实习，最长 12 个月。参与人须为境外高校全日制在读生，或毕业不超过 12 个月。与 Trainee 的区别在于 Intern 面向在读生与应届生，Trainee 面向已有学历加工作经验的在职者。须经国务院指定 Sponsor 办理，岗位须预先落实。","tags":["requires_agency","english_required","rolling","stem_friendly"],"active":true,"status":"eligible","age_min":0,"age_max":null,"age_verified":true,"max_stay_months":12,"education":"bachelor_in_progress","enrollment_scope":"enrolled_or_recent","language_required":true,"funds_amount":null,"funds_currency":null,"risk_levels":["critical","critical","warning","warning","warning","info"],"last_verified":"2026-11-08","source_count":5,"source_primary":5},{"id":"us-j1-research-scholar","name":"美国 J-1 研究学者","name_en":"J-1 Research Scholar","country":"美国","country_code":"US","region":"north_america","program_type":"cultural_exchange","visa_code":"J-1 Research Scholar","official_url":"https://j1visa.state.gov/programs/research-scholar/","authority":"U.S. Department of State, Bureau of Educational and Cultural Affairs（美国国务院教育与文化事务局）","summary":"面向已具研究能力的学者赴美做研究或任教的交流签证，最长 5 年，可带家属（J-2）。不要求美国雇主做劳工证，但必须由指定赞助机构（Sponsor）出具 DS-2019。中国大陆护照持有人不受国籍限制，门槛在学历、英语能力与 Sponsorship。两条最容易被忽略的禁令：不能申请终身教职岗位，且参加后须在境外住满 24 个月才能再次以教授/研究学者身份赴美。","tags":["requires_agency","requires_degree","english_required","stem_friendly","cultural_exchange"],"active":true,"status":"eligible","age_min":0